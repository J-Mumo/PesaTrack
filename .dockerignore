# Repo-root .dockerignore for the website build.
# Compose context is the repo root (see website/docker-compose.yml) and the
# Dockerfile lives at website/Dockerfile. It needs website/ + _docs/ visible.

# --- VCS / editor ---
.git/
.github/
.gitignore
.vscode/
.idea/
.roo/

# --- Not needed by the marketing site ---
android/
backend/
scripts/
docs/
plans/
railway.json
AGENTS.md
README.md
Dockerfile

# --- Build artefacts + local env inside website/ ---
website/node_modules/
website/dist/
website/.astro/
website/.env
website/.env.*
!website/.env.example
website/*.log
website/pa11y-report/
website/lighthouse-report/

# --- OS junk ---
.DS_Store
Thumbs.db

