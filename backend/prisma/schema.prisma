// PesaTrack AI Pro backend — Prisma schema (v0.1.0)
// See plans/ai-pro-phase1-spec.md §4.5

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A user's Google Play Billing purchase — the sole identity anchor.
/// No User table by design: the purchase token IS the identity.
/// No PII is ever stored here.
model Entitlement {
  id String @id @default(cuid())

  /// SHA-256(purchaseToken) — never the raw token. See services/playBilling.js hashToken().
  /// Unique so we can upsert by hash without ever indexing the raw token in the DB.
  purchaseTokenHash String @unique @map("purchase_token_hash")

  /// "pesatrack_pro_monthly" | "pesatrack_pro_annual"
  productId String @map("product_id")

  /// Should always be "com.pesatrack" — rejected otherwise at verify time.
  packageName String @map("package_name")

  /// Play Developer API response fields (normalized).
  expiryTimeMillis BigInt  @map("expiry_time_millis")
  autoRenewing     Boolean @map("auto_renewing")

  /// 0 = pending, 1 = received, 2 = free trial, 3 = pending deferred upgrade/downgrade.
  paymentState Int @map("payment_state")

  /// Non-null when this purchase supersedes an earlier one (upgrade/downgrade chain).
  linkedPurchaseTokenHash String? @map("linked_purchase_token_hash")

  /// Ops.
  lastVerifiedAt DateTime @default(now()) @map("last_verified_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([expiryTimeMillis])
  @@map("entitlements")
}

/// Bounded, PII-free audit trail. Used for post-incident forensics and metrics.
/// Never contains raw tokens, digest bodies, prompts, or LLM outputs.
model AuditEvent {
  id String @id @default(cuid())

  /// "billing.verified" | "billing.expired" | "billing.rejected"
  /// | "ai.echo_called" | "ai.endpoint_called" | "ai.fallback"
  /// | "rate_limit.hit" | "circuit_breaker.tripped"
  type String

  /// SHA-256(purchaseToken).slice(0,16) — same derivation as logs.
  purchaseTokenHash String @map("purchase_token_hash")

  /// Bounded JSON: endpoint name, latency_ms, outcome, fallback_reason.
  /// Enforced at write-site — never contains user text or digest content.
  metadata Json

  createdAt DateTime @default(now()) @map("created_at")

  @@index([type, createdAt])
  @@index([purchaseTokenHash, createdAt])
  @@map("audit_events")
}
