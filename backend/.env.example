# ============================================================
# PesaTrack Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# The .env file is gitignored — NEVER commit real credentials.
#
# For local development: use sandbox values (default).
# For production (Railway): set env vars in the Railway dashboard.
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ============================================================
# M-PESA Daraja API Configuration
# Get credentials from https://developer.safaricom.co.ke
# ============================================================

# Environment: "sandbox" or "production"
# - sandbox  → uses sandbox.safaricom.co.ke (test transactions)
# - production → uses api.safaricom.co.ke (real money!)
MPESA_ENV=sandbox

# Consumer Key & Secret from your Daraja app
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Head Office / Business Shortcode (used for BusinessShortCode + password)
# - Sandbox default: 174379 (PayBill test shortcode)
# - Production: your Head Office shortcode (e.g., 9955604)
MPESA_SHORTCODE=174379

# Till Number / Store Number (only needed for Buy Goods transactions)
# This is the PartyB — where the money is sent
# - Sandbox: not needed (PartyB = shortcode for PayBill)
# - Production: your Till Number (e.g., 4338776)
# MPESA_TILL_NUMBER=4338776

# Lipa Na M-PESA Online Passkey (tied to the Head Office shortcode)
# - Sandbox: uses the default passkey below (no need to change)
# - Production: Safaricom provides a unique passkey for your Head Office shortcode
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Transaction Type (optional — auto-detected from MPESA_ENV)
# - CustomerPayBillOnline   → for PayBill shortcodes
# - CustomerBuyGoodsOnline  → for Till Number (Buy Goods) shortcodes
# If not set, defaults to: sandbox=CustomerPayBillOnline, production=CustomerBuyGoodsOnline
# MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# Callback URL (must be publicly accessible)
# - Local dev: use ngrok (e.g., https://xxxx.ngrok-free.app/api/callback/mpesa)
# - Production: your Railway domain
MPESA_CALLBACK_URL=https://your-domain.com/api/callback/mpesa

# ============================================================
# Database Configuration
# ============================================================

# SQLite for development (file-based, no setup needed)
DATABASE_URL="file:./dev.db"

# PostgreSQL for production (uncomment and configure if needed)
# DATABASE_URL="postgresql://user:password@localhost:5432/pesatrack?schema=public"

# ============================================================
# PRODUCTION QUICK REFERENCE (Railway env vars)
# ============================================================
# Set these in your Railway project dashboard:
#
#   NODE_ENV=production
#   MPESA_ENV=production
#   MPESA_CONSUMER_KEY=<your production consumer key>
#   MPESA_CONSUMER_SECRET=<your production consumer secret>
#   MPESA_SHORTCODE=9955604
#   MPESA_TILL_NUMBER=4338776
#   MPESA_PASSKEY=<your production passkey from Safaricom>
#   MPESA_CALLBACK_URL=https://pesatrack-production.up.railway.app/api/callback/mpesa
#   DATABASE_URL=file:./data/pesatrack.db
# ============================================================
