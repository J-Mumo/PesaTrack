# ============================================================
# PesaTrack API — Environment Variables (v0.1.0)
# ============================================================
# Copy to .env for local dev. NEVER commit real credentials.
# Production values live in Docker secrets / host env on Hetzner.
# See plans/ai-pro-phase1-spec.md §4.4
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info                          # trace|debug|info|warn|error
SERVICE_NAME=pesatrack-api
SERVICE_VERSION=0.1.0

# ---- Database ----
# Local: docker compose up spins up Postgres and this URL resolves to the db service.
# Production: Docker Compose on Hetzner injects the same URL via .env at deploy time.
DATABASE_URL=postgres://pesatrack:changeme@db:5432/pesatrack_api
POSTGRES_PASSWORD=changeme              # openssl rand -hex 24 in prod

# ---- OpenAI ----
# Not used in Phase 1 (only /ai/echo is enabled, which doesn't call the LLM).
# Populated during Phase 2 Coach Insights.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini               # PIN by exact ID — never *-latest
OPENAI_MAX_TOKENS_OUT=800

# ---- Google Play Billing ----
GOOGLE_PLAY_PACKAGE_NAME=com.pesatrack

# Path (inside the container) to the Play Developer service-account JSON.
# In production: mount as a Docker secret at /run/secrets/play_service_account.json
# In local dev with DEV_FAKE_BILLING=true: this path can be blank/nonexistent.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/run/secrets/play_service_account.json

# ---- Dev-only shortcuts ----
# When true, /billing/verify returns a synthetic entitlement without calling
# Google. Useful for wiring tests and local Android dev where nobody has real
# Play purchase tokens. MUST be false in production.
DEV_FAKE_BILLING=true

# ---- Feature flags ----
# Phase-1 policy per spec:
#   ENABLE_AI_ENDPOINTS=false  (real /ai/* endpoints are off; that's Phase 2)
#   ENABLE_AI_ECHO=true        (/ai/echo enabled to prove the pipeline end-to-end)
ENABLE_AI_ENDPOINTS=false
ENABLE_AI_ECHO=true

# ---- CORS ----
# The Android app doesn't send an Origin header (native client), so CORS is
# mainly for the marketing site + browser-based debug tools.
ALLOWED_ORIGIN_WEB=https://pesatrack.jmumo.com
