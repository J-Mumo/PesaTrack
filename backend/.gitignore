# Dependencies
node_modules/

# Environment variables
.env

# Docker Compose local override — NEVER commit
docker-compose.override.yml
docker-compose.override.yaml

# Play service-account JSON (used by real /billing/verify) — NEVER commit.
# Explicit filename patterns handle the common `play_service_account.json`
# and any suffixed variants; the two wildcards below are belt-and-braces
# defence against a rename or a subfolder placement.
play_service_account.json
play_service_account*.json
**/*service-account*.json
**/*service_account*.json

# Any Google Cloud service-account key (broader net). GCP-issued SA JSON
# files start with `{"type":"service_account"` — if a file ever gets that
# shape by mistake, GitHub's push protection will also reject it, but we
# don't want to rely on that as the only line of defence.
gcp-*-key.json
gcp-*-credentials.json

# Any file conventionally holding a private key
*.pem
*private-key*
*-privatekey*

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build output
dist/
build/

# Test coverage
coverage/

# Prisma
/src/generated/prisma
prisma/dev.db
prisma/dev.db-journal
prisma/*.db
prisma/*.db-journal

# SQLite database
dev.db
dev.db-journal
*.db
*.db-journal
