{
  "name": "pesatrack",
  "version": "0.1.0",
  "private": true,
  "description": "PesaTrack marketing site — passive M-PESA expense tracker for Kenya",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir _pagefind",
    "build:astro": "astro build",
    "postbuild": "echo pagefind ran as part of build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "a11y": "pa11y-ci --sitemap http://localhost:4321/sitemap-index.xml"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^5.0.0",
    "astro-og-canvas": "^0.13.1",
    "canvaskit-wasm": "^0.42.0",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.6.0"
  }
}
