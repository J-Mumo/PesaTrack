---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { breadcrumbList, article } from '~/utils/jsonld';

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  return docs.map((d) => ({
    params: { slug: d.id.replace(/\.(md|mdx)$/, '') },
    props: { doc: d },
  }));
}

const { doc } = Astro.props;
const { Content } = await render(doc);
const slug = doc.id.replace(/\.(md|mdx)$/, '');
const url = `/docs/${slug}`;

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Docs', href: '/docs' },
  { name: doc.data.title, href: url },
];

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-KE', { year: 'numeric', month: 'long', day: 'numeric' });

// TechArticle JSON-LD — signals "documentation, not blog post" to answer engines.
const docLd = article({
  title: doc.data.title,
  description: doc.data.dek,
  publishedAt: doc.data.updatedAt ?? new Date(),
  updatedAt: doc.data.updatedAt,
  author: 'PesaTrack',
  url,
});
---

<BaseLayout
  title={doc.data.title}
  description={doc.data.dek}
  canonical={url}
  jsonLd={[breadcrumbList(crumbs), docLd]}
  prose
>
  <Breadcrumbs crumbs={crumbs} />

  <article data-pagefind-body>
    <header class="doc-header">
      {
        doc.data.updatedAt && (
          <p class="meta">Updated {formatDate(doc.data.updatedAt)}</p>
        )
      }
      <h1>{doc.data.title}</h1>
      <p class="dek">{doc.data.dek}</p>
    </header>

    <div class="body">
      <Content />
    </div>

    <footer class="doc-footer">
      <p>
        Something wrong with this page?
        <a href="/support">Tell support</a> — we treat outdated docs as bugs.
        <a href="/docs">← All docs</a>
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .doc-header {
    margin-bottom: var(--space-8);
  }

  .meta {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    margin: 0 0 var(--space-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .dek {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
  }

  .body :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    overflow-x: auto;
    font-size: var(--font-size-sm);
  }

  .body :global(code) {
    background: var(--color-surface-alt);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
    font-size: 0.92em;
  }

  .doc-footer {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }
</style>
