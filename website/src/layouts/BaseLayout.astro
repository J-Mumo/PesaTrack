---
/**
 * BaseLayout — every page renders through this.
 * Emits: meta + JSON-LD in <head>, skip-link, header, main, footer.
 *
 * Per plans/website-full-plan.md §8.2.4, JSON-LD is server-rendered
 * (not JS-injected) so LLM crawlers that don't run JS still see it.
 */
import '~/styles/tokens.css';
import '~/styles/global.css';
import { SITE } from '~/data/site';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  /** Canonical path relative to site root, no trailing slash. Defaults to Astro.url.pathname. */
  canonical?: string;
  /** Additional JSON-LD blocks to emit. Passed as objects, stringified in-place. */
  jsonLd?: Record<string, unknown>[];
  /** Prose page → narrower <main> container. */
  prose?: boolean;
  /** Hide from search + AI crawlers (drafts, WIP). */
  noindex?: boolean;
  /** Absolute-or-relative URL to a page-specific OG image. Falls back to /og-default.png. */
  ogImage?: string;
  /** BCP-47 language tag for the <html> element. Defaults to SITE.locale. */
  lang?: string;
  /**
   * Language alternates for `<link rel="alternate" hreflang="...">` and the
   * x-default marker. Only pass this on pages that have translations.
   */
  alternates?: Array<{ hreflang: string; href: string }>;
}

const {
  title,
  description = SITE.description,
  canonical,
  jsonLd = [],
  prose = false,
  noindex = false,
  ogImage,
  lang = SITE.locale,
  alternates = [],
} = Astro.props;

const canonicalUrl = new URL(
  canonical ?? Astro.url.pathname,
  SITE.url
).toString();

const ogImageUrl = new URL(ogImage ?? '/og/default.png', SITE.url).toString();

const absoluteAlternates = alternates.map((a) => ({
  hreflang: a.hreflang,
  href: new URL(a.href, SITE.url).toString(),
}));

const fullTitle =
  title === SITE.name ? `${SITE.name} — ${SITE.tagline}` : `${title} — ${SITE.name}`;

// Site-wide Organization JSON-LD (§8.2.4)
const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  sameAs: [SITE.playStoreUrl, SITE.githubUrl],
};

// Site-wide WebSite JSON-LD (§8.2.4)
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  inLanguage: lang,
};

const allLd = [orgLd, websiteLd, ...jsonLd];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    {
      absoluteAlternates.map((a) => (
        <link rel="alternate" hreflang={a.hreflang} href={a.href} />
      ))
    }

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang.replace('-', '_')} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD (§8.2.4) -->
    {
      allLd.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />

    <main id="main" class={prose ? 'container container-prose main' : 'container main'}>
      <slot />
    </main>

    <Footer />
  </body>
</html>

<style>
  .main {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
    min-height: 60vh;
  }
</style>
